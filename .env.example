# abe-froman environment template — copy to `.env` and fill in.
# `.env` is gitignored; `.env.example` is committed.
#
# Load via:
#   uv run --env-file .env abe-froman run <config.yaml>
# Or in shell:
#   set -a; source .env; set +a
#
# Auto-detect resolution order (when no `--executor` flag and no
# `settings.executor` in YAML): Anthropic key → DeepSeek key → ACP via
# `npx`. Raises `RuntimeError` if none configured.

# --- Anthropic (native AnthropicBackend) ----------------------------
# Used by `--executor anthropic`. Auto-detect picks this first when set.
ANTHROPIC_API_KEY=sk-ant-...

# --- DeepSeek (OpenAIBackend with DeepSeek base_url) ----------------
# Used by `--executor deepseek`. Auto-detect picks this second.
DEEPSEEK_API_KEY=sk-...

# --- OpenAI / OpenAI-compatible providers ---------------------------
# Used by `--executor openai`. Set base_url for non-OpenAI endpoints.
#
# Examples:
#   OpenRouter:   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:       OPENAI_BASE_URL=http://localhost:11434/v1
#   LM Studio:    OPENAI_BASE_URL=http://localhost:1234/v1
#   LiteLLM:      OPENAI_BASE_URL=http://localhost:4000
#
# OpenAI's default endpoint is used when OPENAI_BASE_URL is unset.
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Alternative: ~/.pi/agent/auth.json -----------------------------
# Anthropic and DeepSeek keys can also be placed in
# ~/.pi/agent/auth.json with the shape
#   {"anthropic": {"key": "..."}, "deepseek": {"key": "..."}}
# Env vars take precedence when both are set.
